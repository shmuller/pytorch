{
  "version": 2,
  "configurePresets": [
    {
      "name": "Release",
      "displayName": "Configure PyTorch/libtorch (Ninja)",
      "description": "On Windows, run in a VS2019 environment.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "${presetName}",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
        "BLAS": "MKL",
        "MKL_THREADING": "OMP",
        "USE_OPENMP": "ON",
        "USE_CUDA": "OFF",
        "USE_ITT": "OFF",
        "USE_KINETO": "OFF",
        "USE_MKLDNN": "ON",
        "USE_NNPACK": "OFF",
        "USE_NUMPY": "OFF",
        "USE_QNNPACK": "OFF",
        "USE_PYTORCH_QNNPACK": "ON",
        "USE_ROCM": "OFF",
        "USE_TBB": "OFF",
        "USE_XNNPACK": "OFF",
        "BUILD_PYTHON": "OFF",
        "BUILD_TEST": "OFF",
        "BUILD_BINARY": "OFF"
      }
    },
    {
      "name": "RelWithDebInfo",
      "inherits": "Release"
    }
  ],
  "buildPresets": [
    {
      "name": "Release",
      "displayName": "Build PyTorch/libtorch (Ninja)",
      "description": "Build and install libtorch.",
      "configurePreset": "Release",
      "targets": ["install"],
      "jobs": 16
    },
    {
      "name": "RelWithDebInfo",
      "inherits": "Release",
      "configurePreset": "RelWithDebInfo"
    }
  ]
}
